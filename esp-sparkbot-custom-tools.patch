+// ============================================================================
+// [本地补丁] 实时取景支持：把摄像头帧转换成 LVGL 可直接显示的 RGB565（小端）
+// ============================================================================
+namespace {
+
+// YUV（全范围近似）转 RGB565 小端。系数与 esp32-camera 的定点实现同源。
+inline uint16_t yuv_to_rgb565(int y, int u, int v) {
+    int r = y + ((1436 * (v - 128)) >> 10);
+    int g = y - ((352 * (u - 128)) >> 10) - ((731 * (v - 128)) >> 10);
+    int b = y + ((1814 * (u - 128)) >> 10);
+    r = r < 0 ? 0 : (r > 255 ? 255 : r);
+    g = g < 0 ? 0 : (g > 255 ? 255 : g);
+    b = b < 0 ? 0 : (b > 255 ? 255 : b);
+    return static_cast<uint16_t>(((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3));
+}
+
+// 一行打包 YUV422 转 RGB565。uyvy_first=true 时字节序为 U Y V Y，否则为 Y U Y V。
+void yuv422_row_to_rgb565(const uint8_t* src, uint16_t* dst, int width, bool uyvy_first) {
+    for (int x = 0; x < width; x += 2) {
+        const int b0 = src[0], b1 = src[1], b2 = src[2], b3 = src[3];
+        int y0, u, y1, v;
+        if (uyvy_first) {
+            u = b0;
+            y0 = b1;
+            v = b2;
+            y1 = b3;
+        } else {
+            y0 = b0;
+            u = b1;
+            y1 = b2;
+            v = b3;
+        }
+        dst[x] = yuv_to_rgb565(y0, u, v);
+        if (x + 1 < width) {
+            dst[x + 1] = yuv_to_rgb565(y1, u, v);
+        }
+        src += 4;
+    }
+}
+
+}  // namespace
+
+bool EspVideo::CaptureRgb565(uint8_t* out, size_t out_capacity, uint16_t* out_width,
+                             uint16_t* out_height) {
+    if (out == nullptr || out_width == nullptr || out_height == nullptr) {
+        return false;
+    }
+    // 取景只丢 1 帧以保帧率；CAPTURE 的 3 帧丢弃策略留给 take_photo 使用
+    if (!CaptureInternal(1)) {
+        return false;
+    }
+    if (frame_.data == nullptr || frame_.len == 0 || frame_.width == 0 || frame_.height == 0) {
+        ESP_LOGE(TAG, "CaptureRgb565: frame is not ready");
+        return false;
+    }
+
+    const int w = frame_.width;
+    const int h = frame_.height;
+    const size_t need = static_cast<size_t>(w) * static_cast<size_t>(h) * 2;
+    if (out_capacity < need) {
+        ESP_LOGE(TAG, "CaptureRgb565: output buffer too small (%u < %u)", (unsigned)out_capacity,
+                 (unsigned)need);
+        return false;
+    }
+
+    auto* dst = reinterpret_cast<uint16_t*>(out);
+    switch (frame_.format) {
+        case V4L2_PIX_FMT_RGB565:
+            memcpy(out, frame_.data, need);
+            break;
+        case V4L2_PIX_FMT_RGB565X: {
+            const auto* s = reinterpret_cast<const uint16_t*>(frame_.data);
+            const size_t n = static_cast<size_t>(w) * h;
+            for (size_t i = 0; i < n; i++) {
+                dst[i] = __builtin_bswap16(s[i]);
+            }
+            break;
+        }
+        case V4L2_PIX_FMT_YUYV:
+        case V4L2_PIX_FMT_YUV422P: {  // esp_video 1.x 用 YUV422P 表示打包 YUYV
+            const size_t row_bytes = static_cast<size_t>(w) * 2;
+            if (frame_.len < row_bytes * h) {
+                ESP_LOGE(TAG, "CaptureRgb565: YUYV frame truncated (%u bytes)",
+                         (unsigned)frame_.len);
+                return false;
+            }
+            for (int y = 0; y < h; y++) {
+                yuv422_row_to_rgb565(frame_.data + static_cast<size_t>(y) * row_bytes,
+                                     dst + static_cast<size_t>(y) * w, w, false);
+            }
+            break;
+        }
+        case V4L2_PIX_FMT_UYVY: {
+            const size_t row_bytes = static_cast<size_t>(w) * 2;
+            if (frame_.len < row_bytes * h) {
+                ESP_LOGE(TAG, "CaptureRgb565: UYVY frame truncated (%u bytes)",
+                         (unsigned)frame_.len);
+                return false;
+            }
+            for (int y = 0; y < h; y++) {
+                yuv422_row_to_rgb565(frame_.data + static_cast<size_t>(y) * row_bytes,
+                                     dst + static_cast<size_t>(y) * w, w, true);
+            }
+            break;
+        }
+        case V4L2_PIX_FMT_GREY: {
+            const size_t n = static_cast<size_t>(w) * h;
+            if (frame_.len < n) {
+                return false;
+            }
+            for (size_t i = 0; i < n; i++) {
+                const int g = frame_.data[i];
+                dst[i] = static_cast<uint16_t>(((g & 0xF8) << 8) | ((g & 0xFC) << 3) | (g >> 3));
+            }
+            break;
+        }
+        case V4L2_PIX_FMT_RGB24: {
+            const size_t n = static_cast<size_t>(w) * h;
+            if (frame_.len < n * 3) {
+                return false;
+            }
+            for (size_t i = 0; i < n; i++) {
+                const int r = frame_.data[i * 3 + 0];
+                const int g = frame_.data[i * 3 + 1];
+                const int b = frame_.data[i * 3 + 2];
+                dst[i] = static_cast<uint16_t>(((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3));
+            }
+            break;
+        }
+        default:
+            ESP_LOGE(TAG, "CaptureRgb565: unsupported sensor format 0x%08lx",
+                     (unsigned long)frame_.format);
+            return false;
+    }
+
+    *out_width = static_cast<uint16_t>(w);
+    *out_height = static_cast<uint16_t>(h);
+    return true;
+}
