+void LcdDisplay::DestroyFullscreenImageLocked() {
+    if (fullscreen_image_ != nullptr) {
+        // LV_EVENT_DELETE 回调里会 delete 掉持有的 LvglImage，这里只需删除对象
+        lv_obj_delete(fullscreen_image_);
+        fullscreen_image_ = nullptr;
+    }
+    if (fullscreen_image_buf_ != nullptr) {
+        heap_caps_free(fullscreen_image_buf_);
+        fullscreen_image_buf_ = nullptr;
+    }
+    fullscreen_image_w_ = 0;
+    fullscreen_image_h_ = 0;
+    fullscreen_active_ = false;
+}
+
+bool LcdDisplay::ShowFullscreenImage(std::unique_ptr<LvglImage> image) {
+    if (image == nullptr) {
+        return false;
+    }
+    const lv_img_dsc_t* dsc = image->image_dsc();
+    if (dsc == nullptr || dsc->header.w == 0 || dsc->header.h == 0) {
+        ESP_LOGE(TAG, "ShowFullscreenImage: invalid image descriptor");
+        return false;
+    }
+
+    DisplayLockGuard lock(this);
+    if (!lock) {
+        return false;
+    }
+    // 若已处于取景模式或已有全屏图，先清掉旧的
+    DestroyFullscreenImageLocked();
+
+    lv_obj_t* obj = lv_image_create(lv_layer_top());
+    lv_obj_remove_flag(obj, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_pad_all(obj, 0, 0);
+    lv_obj_set_style_border_width(obj, 0, 0);
+    lv_obj_set_style_outline_width(obj, 0, 0);
+    lv_obj_set_style_radius(obj, 0, 0);
+    lv_obj_set_style_bg_color(obj, lv_color_black(), 0);
+    lv_obj_set_style_bg_opa(obj, LV_OPA_COVER, 0);
+    lv_obj_set_pos(obj, 0, 0);
+    lv_obj_set_size(obj, width_, height_);
+
+    lv_image_set_src(obj, dsc);
+    // STRETCH 让图片 X/Y 双轴缩放铺满整个控件区域，并自动接管 scale/pivot
+    lv_image_set_inner_align(obj, LV_IMAGE_ALIGN_STRETCH);
+
+    // 所有权转移给 LVGL 对象：对象被删除时释放 LvglImage（其析构会释放底层缓冲）
+    LvglImage* raw_image = image.release();
+    lv_obj_add_event_cb(
+        obj,
+        [](lv_event_t* e) {
+            LvglImage* img = static_cast<LvglImage*>(lv_event_get_user_data(e));
+            if (img != nullptr) {
+                delete img;
+            }
+        },
+        LV_EVENT_DELETE, static_cast<void*>(raw_image));
+
+    fullscreen_image_ = obj;
+    fullscreen_active_ = true;
+    ESP_LOGI(TAG, "Fullscreen image shown: %dx%d (src %ldx%ld)", width_, height_,
+             static_cast<long>(dsc->header.w), static_cast<long>(dsc->header.h));
+    return true;
+}
+
+void LcdDisplay::HideFullscreenImage() {
+    DisplayLockGuard lock(this);
+    if (!lock) {
+        return;
+    }
+    DestroyFullscreenImageLocked();
+    ESP_LOGI(TAG, "Fullscreen image hidden");
+}
+
+bool LcdDisplay::PrepareFullscreenImageBuffer(int width, int height) {
+    if (width <= 0 || height <= 0) {
+        return false;
+    }
+    DisplayLockGuard lock(this);
+    if (!lock) {
+        return false;
+    }
+    DestroyFullscreenImageLocked();
+
+    // 帧缓冲放 PSRAM：240x240x2 = 115200 字节，远大于内部 SRAM 可承受范围
+    const size_t buf_size = static_cast<size_t>(width) * static_cast<size_t>(height) * 2;
+    fullscreen_image_buf_ = static_cast<uint8_t*>(
+        heap_caps_malloc(buf_size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (fullscreen_image_buf_ == nullptr) {
+        ESP_LOGE(TAG, "PrepareFullscreenImageBuffer: allocate %u bytes failed", (unsigned)buf_size);
+        return false;
+    }
+    memset(fullscreen_image_buf_, 0, buf_size);
+
+    lv_obj_t* obj = lv_image_create(lv_layer_top());
+    lv_obj_remove_flag(obj, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_pad_all(obj, 0, 0);
+    lv_obj_set_style_border_width(obj, 0, 0);
+    lv_obj_set_style_outline_width(obj, 0, 0);
+    lv_obj_set_style_radius(obj, 0, 0);
+    lv_obj_set_style_bg_color(obj, lv_color_black(), 0);
+    lv_obj_set_style_bg_opa(obj, LV_OPA_COVER, 0);
+    lv_obj_set_pos(obj, 0, 0);
+    lv_obj_set_size(obj, width_, height_);
+
+    // 直接把帧缓冲包装成 LVGL 图像描述符；LVGL 对内置 RGB565 格式不复制数据，
+    // 因此每帧 memcpy 到该缓冲后 invalidate 即可刷新画面。
+    lv_image_dsc_t* dsc = static_cast<lv_image_dsc_t*>(heap_caps_malloc(
+        sizeof(lv_image_dsc_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (dsc == nullptr) {
+        heap_caps_free(fullscreen_image_buf_);
+        fullscreen_image_buf_ = nullptr;
+        lv_obj_delete(obj);
+        ESP_LOGE(TAG, "PrepareFullscreenImageBuffer: allocate dsc failed");
+        return false;
+    }
+    memset(dsc, 0, sizeof(lv_image_dsc_t));
+    dsc->header.magic = LV_IMAGE_HEADER_MAGIC;
+    dsc->header.cf = LV_COLOR_FORMAT_RGB565;
+    dsc->header.w = static_cast<uint32_t>(width);
+    dsc->header.h = static_cast<uint32_t>(height);
+    dsc->header.stride = static_cast<uint32_t>(width) * 2;
+    dsc->data_size = buf_size;
+    dsc->data = fullscreen_image_buf_;
+
+    lv_image_set_src(obj, dsc);
+    lv_image_set_inner_align(obj, LV_IMAGE_ALIGN_STRETCH);
+
+    // dsc 也随对象一起释放
+    lv_obj_add_event_cb(
+        obj,
+        [](lv_event_t* e) {
+            lv_image_dsc_t* d = static_cast<lv_image_dsc_t*>(lv_event_get_user_data(e));
+            if (d != nullptr) {
+                heap_caps_free(d);
+            }
+        },
+        LV_EVENT_DELETE, static_cast<void*>(dsc));
+
+    fullscreen_image_ = obj;
+    fullscreen_image_w_ = width;
+    fullscreen_image_h_ = height;
+    fullscreen_active_ = true;
+    ESP_LOGI(TAG, "Viewfinder buffer ready: %dx%d (%u bytes in PSRAM)", width, height,
+             (unsigned)buf_size);
+    return true;
+}
+
+uint8_t* LcdDisplay::GetFullscreenImageBuffer(size_t* out_size) {
+    if (out_size != nullptr) {
+        *out_size = fullscreen_image_buf_ != nullptr
+                        ? static_cast<size_t>(fullscreen_image_w_) * fullscreen_image_h_ * 2
+                        : 0;
+    }
+    return fullscreen_image_buf_;
+}
+
+void LcdDisplay::PresentFullscreenImageBuffer() {
+    if (fullscreen_image_ == nullptr) {
+        return;
+    }
+    // 这里不做数据拷贝：摄像头已直接写入 fullscreen_image_buf_，只需标记脏区。
+    // 因此使用非阻塞 Lock，显示忙时直接放弃这一帧。
+    if (!Lock(200)) {
+        return;
+    }
+    lv_obj_invalidate(fullscreen_image_);
+    Unlock();
+}
+
+void LcdDisplay::ReleaseFullscreenImageBuffer() {
+    DisplayLockGuard lock(this);
+    if (!lock) {
+        return;
+    }
+    DestroyFullscreenImageLocked();
+    ESP_LOGI(TAG, "Viewfinder buffer released");
+}
