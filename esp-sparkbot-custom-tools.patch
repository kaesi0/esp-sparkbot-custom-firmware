+    ToolResult ShowImageFromUrl(const std::string& url) {
+        // 取景与全屏静态图共用同一个图层。若取景线程还没退干净就销毁画面缓冲，
+        // 会造成 use-after-free，因此这里必须确认停止成功后才继续。
+        if (!StopViewfinder()) {
+            return std::unexpected("Real-time viewfinder is still shutting down, please retry");
+        }
+
+        // 官方 preview_image 用的是 3 秒超时，公网图片（尤其首次 TLS 握手）经常不够。
+        // 这里放宽到 15 秒。若图片由内网服务提供 240x240 缩略图，通常几百毫秒即可完成。
+        auto http = Board::GetInstance().GetNetwork()->CreateHttp(15);
+        if (http == nullptr) {
+            return std::unexpected("Failed to create HTTP client");
+        }
+        if (auto opened = http->Open("GET", url); !opened) {
+            return std::unexpected("Failed to open URL: " + url + " (" + opened.error().ToString() +
+                                   ")");
+        }
+        auto status_code = http->GetStatusCode();
+        if (!status_code) {
+            http->Close();
+            return std::unexpected(status_code.error().ToString());
+        }
+        if (*status_code != 200) {
+            http->Close();
+            return std::unexpected("Unexpected status code: " + std::to_string(*status_code));
+        }
+
+        const size_t content_length = http->GetBodyLength();
+        // 上限 1MB：既防止 PSRAM 被单张图撑爆，也隐含要求服务端下发缩略图而非原图
+        constexpr size_t kMaxImageBytes = 1024 * 1024;
+        if (content_length == 0 || content_length > kMaxImageBytes) {
+            http->Close();
+            return std::unexpected("Image size not acceptable: " +
+                                   std::to_string(content_length) +
+                                   " bytes (must be 1..1048576)");
+        }
+
+        using BufferPtr = std::unique_ptr<char, decltype(&heap_caps_free)>;
+        BufferPtr data(static_cast<char*>(heap_caps_malloc(
+                           content_length, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT)),
+                       heap_caps_free);
+        if (data == nullptr) {
+            http->Close();
+            return std::unexpected("Out of memory for image download");
+        }
+        size_t total_read = 0;
+        while (total_read < content_length) {
+            auto ret = http->Read(data.get() + total_read, content_length - total_read);
+            if (!ret) {
+                http->Close();
+                return std::unexpected("Failed to download image");
+            }
+            if (*ret == 0) {
+                break;
+            }
+            total_read += *ret;
+        }
+        http->Close();
+
+        // 两级解码：
+        //   1) 先交给 LVGL 解码器（本固件启用了 CONFIG_LV_USE_LODEPNG，覆盖 PNG/BMP 等）
+        //   2) 不行再回退到固件自带的 jpeg_to_image()（输出 RGB565），覆盖 JPEG
+        // 这一步回退不是可选项：本固件没有启用 LVGL 的 JPEG 解码器
+        // （LV_USE_SJPG / LV_USE_TJPGD 均未开启），而 Seedream 等生图服务默认返回 JPEG。
+        std::unique_ptr<LvglAllocatedImage> image;
+        {
+            lv_image_dsc_t probe = {};
+            probe.data_size = total_read;
+            probe.data = reinterpret_cast<uint8_t*>(data.get());
+            lv_image_header_t header = {};
+            if (lv_image_decoder_get_info(&probe, &header) == LV_RESULT_OK) {
+                image = std::make_unique<LvglAllocatedImage>(data.release(), total_read);
+            }
+        }
+        if (image == nullptr) {
+            uint8_t* rgb = nullptr;
+            size_t rgb_len = 0;
+            size_t jw = 0;
+            size_t jh = 0;
+            size_t stride = 0;
+            const esp_err_t jerr = jpeg_to_image(reinterpret_cast<const uint8_t*>(data.get()),
+                                                 total_read, &rgb, &rgb_len, &jw, &jh, &stride);
+            if (jerr != ESP_OK || rgb == nullptr) {
+                return std::unexpected(
+                    "Unsupported image format (this firmware can decode PNG and JPEG only)");
+            }
+            data.reset();  // 压缩数据已无用，解码结果另占一块内存
+            ESP_LOGI(TAG, "JPEG decoded to RGB565: %ux%u stride=%u len=%u", static_cast<unsigned>(jw),
+                     static_cast<unsigned>(jh), static_cast<unsigned>(stride),
+                     static_cast<unsigned>(rgb_len));
+            image = std::make_unique<LvglAllocatedImage>(
+                rgb, rgb_len, static_cast<int>(jw), static_cast<int>(jh), static_cast<int>(stride),
+                LV_COLOR_FORMAT_RGB565);
+        }
+        if (image == nullptr || !image->IsValid()) {
+            return std::unexpected("Failed to decode the downloaded image");
+        }
+        if (display_ == nullptr || !display_->ShowFullscreenImage(std::move(image))) {
+            return std::unexpected("Display does not support fullscreen image");
+        }
+        ESP_LOGI(TAG, "Image shown fullscreen: %u bytes from %s", static_cast<unsigned>(total_read),
+                 url.c_str());
+        return std::string("图片已全屏显示在设备屏幕上");
+    }
