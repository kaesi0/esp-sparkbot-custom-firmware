+    static void ViewfinderTaskEntry(void* arg) {
+        static_cast<EspSparkBot*>(arg)->ViewfinderLoop();
+    }
+
+    void ViewfinderLoop() {
+        // 约 10fps：帧率瓶颈在 YUV->RGB565 软件转换与 240x240 SPI 全屏刷新。
+        // 屏幕是 20 行条带局部刷新（见 display/lcd_display.cc），实测 8~12fps 属正常。
+        constexpr int kFrameIntervalMs = 100;
+        while (viewfinder_running_.load()) {
+            size_t buf_size = 0;
+            uint8_t* buf = display_->GetFullscreenImageBuffer(&buf_size);
+            if (buf == nullptr) {
+                ESP_LOGE(TAG, "Viewfinder: frame buffer gone, abort loop");
+                break;
+            }
+            uint16_t out_w = 0;
+            uint16_t out_h = 0;
+            if (camera_->CaptureRgb565(buf, buf_size, &out_w, &out_h)) {
+                display_->PresentFullscreenImageBuffer();
+            } else {
+                ESP_LOGW(TAG, "Viewfinder: capture frame failed");
+                vTaskDelay(pdMS_TO_TICKS(200));
+                continue;
+            }
+            vTaskDelay(pdMS_TO_TICKS(kFrameIntervalMs));
+        }
+
+        // 画面缓冲的释放固定在任务内部完成：这样 StopViewfinder 只需等待任务结束，
+        // 不会出现「主线程已释放缓冲、取景线程还在写入」的 use-after-free。
+        display_->ReleaseFullscreenImageBuffer();
+        viewfinder_task_ = nullptr;
+        ESP_LOGI(TAG, "Viewfinder loop exited");
+        vTaskDelete(nullptr);
+    }
+
+    bool WaitViewfinderExit(int timeout_ms) {
+        int waited = 0;
+        while (viewfinder_task_ != nullptr && waited < timeout_ms) {
+            vTaskDelay(pdMS_TO_TICKS(20));
+            waited += 20;
+        }
+        return viewfinder_task_ == nullptr;
+    }
+
+    ToolResult StartViewfinder() {
+        if (viewfinder_running_.load()) {
+            return std::string("实时取景已经在运行中");
+        }
+        if (!WaitViewfinderExit(5000)) {
+            return std::unexpected("上一次取景任务尚未退出，请稍后再试");
+        }
+        if (camera_ == nullptr || !camera_->IsStreaming()) {
+            return std::unexpected("摄像头未就绪，无法启动取景");
+        }
+        const uint16_t w = camera_->frame_width();
+        const uint16_t h = camera_->frame_height();
+        if (w == 0 || h == 0) {
+            return std::unexpected("摄像头未上报分辨率，无法启动取景");
+        }
+        if (display_ == nullptr || !display_->PrepareFullscreenImageBuffer(w, h)) {
+            return std::unexpected("内存不足，无法为取景画面分配缓冲");
+        }
+
+        viewfinder_running_ = true;
+        // 用局部变量接收句柄：ESP32-S3 是双核，新任务可能在 xTaskCreate 返回前就跑起来，
+        // 若它提前退出会把 viewfinder_task_ 置空，随后被 xTaskCreate 写回覆盖成"任务已存在"
+        // 的假象。先落在局部变量上，等创建函数返回后再赋值给成员，避免这个竞态。
+        TaskHandle_t handle = nullptr;
+        if (xTaskCreate(ViewfinderTaskEntry, "spark_view", 5120, this, 3, &handle) != pdPASS) {
+            viewfinder_running_ = false;
+            display_->ReleaseFullscreenImageBuffer();
+            return std::unexpected("创建取景任务失败");
+        }
+        viewfinder_task_ = handle;
+        ESP_LOGI(TAG, "Viewfinder started: %ux%u", static_cast<unsigned>(w),
+                 static_cast<unsigned>(h));
+        return std::string("实时取景已打开，画面已显示在屏幕上");
+    }
+
+    // 停止取景。返回 true 表示已确认取景线程退出（即画面缓冲已安全释放，不会再有写入者）。
+    //
+    // 注意：这里不能只看 viewfinder_running_ 标志就返回。MENU 键走的是"只置标志、让任务
+    // 自行退出"的路径，此时标志已是 false 但任务可能还在写最后一帧；调用方若据此就销毁
+    // 画面缓冲，会造成 use-after-free。因此只要任务句柄还没清空，就必须等它真正退出。
+    bool StopViewfinder() {
+        const bool was_running = viewfinder_running_.exchange(false);
+        if (!was_running && viewfinder_task_ == nullptr) {
+            return true;
+        }
+        if (!WaitViewfinderExit(5000)) {
+            // 取景线程可能阻塞在 DQBUF 上；此时绝不能由主线程释放缓冲，
+            // 交给该线程退出时自行释放，避免野指针。
+            ESP_LOGE(TAG,
+                     "Viewfinder task did not exit within 5s; buffer will be released by the task");
+            return false;
+        }
+        ESP_LOGI(TAG, "Viewfinder stopped");
+        return true;
+    }
